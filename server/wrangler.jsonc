{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyofit-api",
  // Same account as JoyoRogo (Dzulfikar.at@gmail.com's Account).
  "account_id": "b7e6f8457bd39fa37a7eea5249799754",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "api.fit.joyorogo.com", "custom_domain": true }],
  // Kept on so already-installed builds that call the workers.dev host keep working.
  "workers_dev": true,
  "vars": {
    // JoyoRogo's better-auth origin. Sessions are verified against `${JOYOROGO_AUTH_URL}/api/auth/get-session`.
    "JOYOROGO_AUTH_URL": "https://api.joyorogo.com",
    // Largest accepted POST /v1/imports body, in bytes (100 MiB).
    "MAX_IMPORT_BYTES": "104857600",
    // The Strava API application shared with JoyoRogo (client id is public; docs/strava.md). The matching
    // STRAVA_CLIENT_SECRET (the same value JoyoRogo's Worker has) and STRAVA_WEBHOOK_VERIFY_TOKEN are Worker
    // secrets: `bunx wrangler secret put <NAME>`.
    "STRAVA_CLIENT_ID": "287873",
    // The manual Strava upload in the app (a workaround for everyone while Strava capacity is limited): "on" unless
    // "off". Turn off when Strava grants extended capacity (9,999); turn back on if the slots fill up. docs/strava.md 2a.
    "STRAVA_MANUAL_UPLOAD": "on",
    // Sender of family alert emails; same sender as JoyoRogo.
    "EMAIL_FROM": "halo@mail.joyorogo.com",
    "EMAIL_FROM_NAME": "JoyoFit"
  },
  // Family monitoring (docs/family-monitoring.md): alert checks every 15 minutes, the digest at 19:00 WIB, a nightly purge.
  "triggers": { "crons": ["*/15 * * * *", "0 12 * * *", "0 20 * * *"] },
  // Alert emails and the digest. The sending domain must be onboarded for Email Sending in this account.
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joyofit",
      "database_id": "fe079319-963d-454d-9625-35eee1462a8b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMPORTS",
      "bucket_name": "joyofit-imports"
    },
    // Public offline watch maps (src/maps.ts, docs/offline-maps.md; tools/offline-maps/publish.py): watch/catalog.json + watch/<id>.bin, no user data. The same bucket holds the bike
    // computer's PMTiles (docs/bike-computer.md), public at maps.fit.joyorogo.com.
    {
      "binding": "MAPS",
      "bucket_name": "joyofit-maps"
    }
  ],
  // "Ride on the web" relay (docs/ride.md): one RideRoom per ride (hibernatable WebSockets, idle expiry by alarm), one RideIndex
  // per join code and per rate-limit key. Both are SQLite-backed Durable Objects.
  "durable_objects": {
    "bindings": [
      { "name": "RIDE_ROOM", "class_name": "RideRoom" },
      { "name": "RIDE_INDEX", "class_name": "RideIndex" }
    ]
  },
  "migrations": [{ "tag": "ride-v1", "new_sqlite_classes": ["RideRoom", "RideIndex"] }]
  // Optional, same-account only: call JoyoRogo through a service binding instead of HTTPS.
  // Replace the service with JoyoRogo's deployed Worker name, then uncomment. See README.md.
  // "services": [{ "binding": "AUTH_SERVICE", "service": "REPLACE_WITH_JOYOROGO_WORKER_NAME" }]
}
