{
  "name": "joyofit-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "JoyoFit Studio: a web watch-face editor for Huawei watches (Watch Fit 4 / Fit 4 Pro, round GT, Band, or a custom screen). Exports a photo face for JoyoFit and a Huawei .hwt for Huawei's tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsrs --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "i18next": "^26.4.7",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.20",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
