{
  "name": "joyofit-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Landing page for JoyoFit (fit.joyorogo.com).",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/gen-timbangan.ts && tsrs --noEmit && vite build && bun scripts/prerender.ts",
    "typecheck": "tsrs --noEmit",
    "jam": "bun scripts/gen-jam.ts",
    "timbangan": "bun scripts/gen-timbangan.ts",
    "test": "bun test scripts",
    "og": "chromium --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --screenshot=public/og.png og/og-image.html",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.158.0"
  }
}
