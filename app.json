      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-release-signing",
      "./plugins/with-version-code",
      "./plugins/with-shared-fit",
      "./plugins/with-no-badge-permissions",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0A6580",
          "defaultChannel": "family"
        }
      ],
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "JoyoFit reads a photo only when you pick one, for a watch face or for the image of a workout you share, and when you send that image to Instagram.",
          "cameraPermission": "JoyoFit uses the camera only when you take a photo to put behind the numbers of a workout you share.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "JoyoFit reads a photo only when you pick one, for a watch face or for the image of a workout you share, and when you send that image to Instagram.",
          "savePhotosPermission": "JoyoFit saves the image of a workout or day you share to your photos, only when you tap Save.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-share",
        {
          "android": ["com.instagram.android"],
          "ios": ["instagram", "instagram-stories"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F9F6F1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0D1112"
          }
        }
      ]
    ],
