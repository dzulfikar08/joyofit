{
  "expo": {
    "name": "JoyoFit",
    "slug": "joyofit",
    "version": "1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "joyofit",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.joyodigitama.joyofit",
      "buildNumber": "1",
      "appleTeamId": "F6Q6UFUK69",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "JoyoFit uses Bluetooth to connect to your Huawei or Honor watch and sync its data, to heart rate straps, cycling sensors and running pods you pair, to record their heart rate, speed, cadence and power during a workout, and to a Bluetooth bathroom scale you pick, to read your weight.",
        "NSBluetoothPeripheralUsageDescription": "JoyoFit uses Bluetooth to connect to your Huawei or Honor watch and sync its data, to heart rate straps, cycling sensors and running pods you pair, to record their heart rate, speed, cadence and power during a workout, and to a Bluetooth bathroom scale you pick, to read your weight.",
        "NSLocationWhenInUseUsageDescription": "JoyoFit uses your location to look up the weather for your area (only coordinates rounded to about 1 km go to the weather service, Open-Meteo), to send your position to your watch while a workout you started on the watch is running, and to record the route, distance and pace of an outdoor workout you start on the phone, also with the screen locked while that workout runs. Nothing else leaves your phone.",
        "NSHealthShareUsageDescription": "JoyoFit reads your Apple Health history once, only when you tap Import history from Apple Health, to bring the steps, heart rate, sleep, blood oxygen, active energy and workouts that Huawei Health saved there into JoyoFit. It stays on your phone.",
        "NSHealthUpdateUsageDescription": "Allow JoyoFit to save the steps, distance, calories, heart rate, blood oxygen, sleep, workouts and workout routes recorded by your watch to Apple Health.",
        "UIBackgroundModes": ["bluetooth-central", "location"],
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "FIT activity",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.joyodigitama.joyofit.fit"]
          },
          {
            "CFBundleTypeName": "GPX route",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.joyodigitama.joyofit.gpx"]
          },
          {
            "CFBundleTypeName": "TCX route",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.joyodigitama.joyofit.tcx"]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.joyodigitama.joyofit.fit",
            "UTTypeDescription": "FIT activity file",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["fit"],
              "public.mime-type": ["application/vnd.ant.fit"]
            }
          },
          {
            "UTTypeIdentifier": "com.joyodigitama.joyofit.gpx",
            "UTTypeDescription": "GPX route file",
            "UTTypeConformsTo": ["public.xml"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["gpx"],
              "public.mime-type": ["application/gpx+xml"]
            }
          },
          {
            "UTTypeIdentifier": "com.joyodigitama.joyofit.tcx",
            "UTTypeDescription": "TCX route file",
            "UTTypeConformsTo": ["public.xml"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["tcx"],
              "public.mime-type": ["application/vnd.garmin.tcx+xml"]
            }
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.joyodigitama.joyofit",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
